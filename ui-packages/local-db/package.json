{
  "name": "@gamma-compose/local-db",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "src",
    "skills",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./bridge": {
      "types": "./src/bridge-host.ts",
      "development": "./src/bridge-host.ts",
      "import": "./dist/bridge-host.js"
    },
    "./preview": {
      "types": "./src/preview.ts",
      "source": "./src/preview.ts",
      "development": "./src/preview.ts",
      "import": "./dist/preview.js"
    },
    "./skills/local-db": {
      "default": "./skills/local-db/SKILL.md"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
