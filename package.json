{
  "name": "gamma-compose",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gamma-compose/web --filter @gamma-compose/server dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "biome check . && pnpm typecheck && pnpm test",
    "build": "pnpm -r build",
    "start": "pnpm --filter @gamma-compose/server start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5"
  }
}
